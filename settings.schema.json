{
  "properties": {
    "unknownViewInspection": {
      "type": "boolean",
      "title": "Report unknown views",
      "default": true
    },
    "unknownRouteInspection": {
      "type": "boolean",
      "title": "Report unknown route names",
      "default": false
    },
    "unknownRuleInspection": {
      "type": "boolean",
      "title": "Report unknown validation rules",
      "default": true
    },
    "unknownColumnInspection": {
      "type": "boolean",
      "title": "Report columns that don't exist in the model's table (where, orderBy, pluck\u2026)",
      "default": true
    },
    "envCallInspection": {
      "type": "boolean",
      "title": "Report env() calls outside config files",
      "default": true
    },
    "fillableInspection": {
      "type": "boolean",
      "title": "Report create() and similar keys that $fillable leaves out",
      "default": true
    },
    "nPlusOneInspection": {
      "type": "boolean",
      "title": "Report relations loaded once per item in a foreach (N+1 queries)",
      "default": true
    },
    "envKeysInspection": {
      "type": "boolean",
      "title": "Report keys that are in .env but not in .env.example, and the other way around",
      "default": true
    },
    "unknownAuthInspection": {
      "type": "boolean",
      "title": "Report unknown middleware and abilities",
      "default": false
    },
    "unknownOpenApiRefInspection": {
      "type": "boolean",
      "title": "Report unknown OpenAPI $ref components",
      "default": true
    },
    "locale": {
      "type": "string",
      "title": "Preferred translation locale",
      "default": "en"
    },
    "artisanRunner": {
      "type": "string",
      "title": "Run Artisan with",
      "enum": [
        "auto",
        "php",
        "docker-run",
        "docker"
      ],
      "default": "auto"
    },
    "formatOnSave": {
      "type": "string",
      "title": "Format PHP files on save with",
      "enum": [
        "off",
        "pint",
        "php-cs-fixer"
      ],
      "default": "off"
    },
    "phpstanOnSave": {
      "type": "boolean",
      "title": "Run PHPStan (and Larastan) on the saved file and show its errors",
      "default": false
    },
    "dockerService": {
      "type": "string",
      "title": "Docker Compose service for Artisan (empty: detect)",
      "default": ""
    }
  }
}
